<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
    <style>
      body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
      .container { max-width: 600px; margin: 0 auto; padding: 20px; }
      .header { background-color: #7f1d1d; color: white; padding: 20px; text-align: center; }
      .content { background-color: #f9fafb; padding: 24px; border: 1px solid #e5e7eb; }
      .footer { margin-top: 20px; padding-top: 20px; border-top: 1px solid #e5e7eb; font-size: 12px; color: #6b7280; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Thank You</h1>
      </div>

      <div class="content">
        <% greeting = @rental_request.contact_name.presence || @rental_request.customer_first_name.presence || 'there' %>
        <p>Hi <%= greeting %>,</p>

        <p>
          Thank you for filling out a rental request form. Your requested equipment has been set
          aside for you. Due to the nature of the rental request, draft invoices will be shared
          with you for approval. Your business is important to us, and we will contact you shortly.
        </p>

        <p>&mdash; The RM Jobsite Solutions Team</p>
      </div>

      <div class="footer">
        <p>This is an automated confirmation from RM Jobsite Solutions. If you have questions, reply to this email or contact support@rmjobsites.com.</p>
      </div>
    </div>
  </body>
</html>
